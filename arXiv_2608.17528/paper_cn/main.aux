\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces 一个重分词示例。第 $i$ 次调用中单词 \texttt  {having} 被采样为 \texttt  {h} 与 \texttt  {aving} 两个 token（\emph  {上}）；当更新后的消息历史为第 $i{+}1$ 次调用重新分词时，同一文本可能被切分为 \texttt  {hav} 与 \texttt  {ing} 的不同 token 边界（\emph  {下}）。尽管底层文本相同，token 边界却不同。即使式~\ref {eq:text-prefix} 的文本级前缀条件仍成立，式~\ref {eq:token-prefix} 的 token 级前缀条件也被破坏。}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:retokenization}{{3}{4}{一个重分词示例。第 $i$ 次调用中单词 \texttt {having} 被采样为 \texttt {h} 与 \texttt {aving} 两个 token（\emph {上}）；当更新后的消息历史为第 $i{+}1$ 次调用重新分词时，同一文本可能被切分为 \texttt {hav} 与 \texttt {ing} 的不同 token 边界（\emph {下}）。尽管底层文本相同，token 边界却不同。即使式~\ref {eq:text-prefix} 的文本级前缀条件仍成立，式~\ref {eq:token-prefix} 的 token 级前缀条件也被破坏。}{figure.caption.3}{}}
